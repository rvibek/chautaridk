# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://user:password@localhost:5432/chautari
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
APP_URL=http://localhost:3000

ADMIN_ALLOWED_EMAILS=admin@chautari.dk
SUPER_ADMIN_EMAILS=admin@chautari.dk

DEV_LOGIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@chautari.dk
# Optional extra admin created by the seed script.
SEED_EDITOR_EMAIL=
# Sample stories are seeded automatically outside production. Keep false in production.
SEED_SAMPLE_CONTENT=false

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AI intake pipeline. Gemini is the default provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

RESEND_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
