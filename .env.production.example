# Production environment template.
# Copy to `.env.production`, fill in the real values, and never commit it.
# Use `openssl rand -base64 32` for AUTH_SECRET and a long random database password.
# If the database password contains URL-reserved characters, URL-encode it in DATABASE_URL.

APP_IMAGE=ghcr.io/rvibek/chautaridk:latest
TOOLS_IMAGE=ghcr.io/rvibek/chautaridk:tools
DOMAIN=chautari.dk
ACME_EMAIL=admin@example.com

POSTGRES_DB=chautari
POSTGRES_USER=chautari
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://chautari:replace-with-a-long-random-password@db:5432/chautari

AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
AUTH_URL=https://chautari.dk
APP_URL=https://chautari.dk
ADMIN_ALLOWED_EMAILS=admin@example.com
SUPER_ADMIN_EMAILS=admin@example.com
DEV_LOGIN_ENABLED=false

SEED_ADMIN_EMAIL=admin@example.com
SEED_EDITOR_EMAIL=
SEED_SAMPLE_CONTENT=false

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

RESEND_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional offsite backup target for rclone, for example: r2:chautari-backups
R2_REMOTE=
BACKUP_RETENTION_DAYS=14
